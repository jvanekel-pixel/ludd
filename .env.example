# LUDD has no required environment variables to run. Names found in the code, with placeholders.
# Never put real secrets in this file.

# Where the engine keeps its data (defaults to the per-user app data folder; old "Threadline" folder still works)
THREADLINE_DATA_DIR=

# Release builds only (GitHub Actions secrets): updater signing
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Tests only: folder holding an AI tracing model for the engine's AI tests
LUDD_TEST_AI_MODEL_DIR=
