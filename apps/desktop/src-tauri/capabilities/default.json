{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: title, light/dark frame and close prompt, native open/save dialogs, the bundled engine sidecar, checking for and installing updates, and restarting after an update.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/threadline-engine",
          "sidecar": true
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "updater:default",
    "process:allow-restart"
  ]
}
