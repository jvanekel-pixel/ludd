{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LUDD",
  "mainBinaryName": "LUDD",
  "version": "1.0.0",
  "identifier": "app.ludd.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LUDD",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "externalBin": [
      "binaries/threadline-engine"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "LUDD",
    "copyright": "LUDD contributors. GPL-3.0-or-later.",
    "shortDescription": "Free, open-source embroidery software",
    "longDescription": "Open, edit, draw and letter embroidery designs and save them for your machine (PES, JEF and more). Works offline; no account.",
    "category": "GraphicsAndDesign",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../samples/": "samples/"
    },
    "fileAssociations": [
      {
        "ext": [
          "ludd"
        ],
        "name": "LUDD project",
        "description": "LUDD embroidery project",
        "role": "Editor",
        "mimeType": "application/x-ludd"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFNEE2MEU0NERDMkRCQzAKUldUQTI4Sk41R0JLRGpvT3VZTXVyZHY3WEJWelp5OUF1V0hqZEpjaGV0N0xqY0hsVVhtWm82STAK",
      "endpoints": [
        "https://github.com/jvanekel-pixel/ludd/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
